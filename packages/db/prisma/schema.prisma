// TeleTrade Prisma schema
// All entities are tenant-scoped via tenantId for multi-tenant readiness.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  ADMIN
  SALES_MANAGER
  AGENT
  DELIVERY_OPS
}

enum CustomerStatus {
  ACTIVE
  DORMANT
  UNREACHABLE
  PHONE_ONLY
  SUSPENDED
}

enum AccountTier {
  A
  B
  C
  D
}

enum OutletType {
  KIOSK
  MAMA_PUT
  SUPERMARKET
  MINI_MART
  WHOLESALER
  BAR
  RESTAURANT
  PHARMACY
  TABLE_TOP
}

enum LanguagePreference {
  EN
  FR
  PT
  SW
  HA
  YO
  IG
  AR
  ZU
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  QUEUED
  RINGING
  CONNECTED
  COMPLETED
  MISSED
  DROPPED
  FAILED
  CALLBACK_SCHEDULED
}

enum CallOutcome {
  ORDER_CREATED
  NO_ORDER
  CALLBACK_SCHEDULED
  WRONG_NUMBER
  DECLINED
  UNREACHABLE
  COMPLAINT
  INFO_REQUEST
}

enum CampaignType {
  NPI_LAUNCH
  PROMO_PUSH
  DORMANT_REACTIVATION
  GAP_FILL_REPLENISHMENT
  CREDIT_COLLECTION
  CUSTOMER_SURVEY
  COMPLAINT_FOLLOW_UP
  AFTER_SALES_SUPPORT
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum CampaignTargetStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  UNREACHABLE
  DECLINED
  SKIPPED
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PENDING_SYNC
  SYNCED
  FLAGGED_DUPLICATE
  ASSIGNED_TO_ROUTE
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  FAILED
}

enum DmsAdapterKind {
  ODOO
  SAP_B1
  DYNAMICS_365
  CUSTOM
}

enum DmsSyncStatus {
  PENDING
  IN_FLIGHT
  SUCCEEDED
  FAILED
  DEAD_LETTER
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum DuplicateReviewStatus {
  PENDING
  KEPT_BOTH
  CANCELLED_DUPLICATE
  MERGED
  MARKED_VALID
}

enum DeliveryStatus {
  PLANNED
  PICKED
  IN_TRANSIT
  DELIVERED
  FAILED
  RESCHEDULED
}

enum DeliveryFailureReason {
  OUTLET_CLOSED
  NOT_ENOUGH_CASH
  WRONG_SKU
  DAMAGED
  NO_ANSWER
  OTHER
}

enum PaymentMethod {
  CASH
  TRANSFER
  POS
  CREDIT
}

enum PlanTier {
  FREE
  STARTER
  GROWTH
  ENTERPRISE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

// ---------- Core ----------

model Tenant {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  /// Billing / commercial settings. Free tier = single workspace for a trial.
  plan           PlanTier        @default(STARTER)
  seatLimit      Int             @default(10)
  billingEmail   String?
  industry       String?         // FMCG / Beverages / Pharma / etc.
  country        String?
  timezone       String?         // IANA name, e.g. "Africa/Lagos"
  logoUrl        String?
  /// Override the env-level DMS adapter at the tenant level.
  dmsAdapter     DmsAdapterKind?
  /// Tenant-scoped DMS connection settings (URL, auth) — JSON blob.
  dmsConfig      Json?
  /// Set when the workspace is scheduled for deletion.
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  users         User[]
  customers     Customer[]
  routes        Route[]
  territories   Territory[]
  skus          Sku[]
  promotions    Promotion[]
  calls         Call[]
  campaigns     Campaign[]
  orders        Order[]
  auditLogs     AuditLog[]
  dmsSyncJobs   DmsSyncJob[]
  webhookEvents WebhookEvent[]
  suggestions   Suggestion[]
  invitations   Invitation[]
}

model Invitation {
  id          String           @id @default(cuid())
  tenantId    String
  email       String
  fullName    String
  role        Role
  /// One-use opaque token (hashed at rest); presented in URL to the invitee.
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("InvitationInviter", fields: [invitedById], references: [id])

  @@index([tenantId, status])
  @@index([email])
}

model User {
  id            String   @id @default(cuid())
  tenantId      String
  email         String   @unique
  passwordHash  String
  fullName      String
  role          Role
  languages     LanguagePreference[]
  active        Boolean  @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  refreshTokens  RefreshToken[]
  ownedCalls     Call[]
  ownedOrders    Order[]
  createdCampaigns Campaign[]
  auditLogs      AuditLog[]
  deliveries     DeliveryAssignment[]
  invitationsSent Invitation[]  @relation("InvitationInviter")

  @@index([tenantId])
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Geography ----------

model Territory {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  routes    Route[]
  customers Customer[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Route {
  id          String   @id @default(cuid())
  tenantId    String
  territoryId String
  name        String
  code        String
  scheduleDow Int[]    // days of week 0-6 the route runs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  territory   Territory  @relation(fields: [territoryId], references: [id])
  customers   Customer[]
  deliveries  DeliveryAssignment[]

  @@unique([tenantId, code])
  @@index([tenantId, territoryId])
}

// ---------- Catalog ----------

model Sku {
  id          String   @id @default(cuid())
  tenantId    String
  code        String
  name        String
  brand       String
  category    String
  unitPrice   Decimal  @db.Decimal(12, 2)
  packSize    String   // e.g. "12 x 50cl"
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  orderLines  OrderLine[]
  suggestions Suggestion[]

  @@unique([tenantId, code])
  @@index([tenantId, category])
}

model Promotion {
  id              String       @id @default(cuid())
  tenantId        String
  name            String
  code            String
  description     String
  startsAt        DateTime
  endsAt          DateTime
  active          Boolean      @default(true)
  applicableSkus  String[]     // sku codes
  applicableOutletTypes OutletType[]
  discountPct     Decimal?     @db.Decimal(5, 2)
  freeUnits       Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  orders Order[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
}

// ---------- Customer 360 ----------

model Customer {
  id                  String              @id @default(cuid())
  tenantId            String
  outletName          String
  contactName         String
  phone               String
  altPhone            String?
  languagePreference  LanguagePreference  @default(EN)
  outletType          OutletType
  address             String
  latitude            Decimal?            @db.Decimal(10, 7)
  longitude           Decimal?            @db.Decimal(10, 7)
  routeId             String?
  territoryId         String?
  accountTier         AccountTier         @default(C)
  status              CustomerStatus      @default(ACTIVE)
  preferredSkus       String[]            // sku codes
  notes               String?
  nextDeliveryDate    DateTime?
  lastOrderDate       DateTime?
  creditLimit         Decimal?            @db.Decimal(12, 2)
  outstandingBalance  Decimal?            @db.Decimal(12, 2)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  route       Route?     @relation(fields: [routeId], references: [id])
  territory   Territory? @relation(fields: [territoryId], references: [id])
  calls       Call[]
  orders      Order[]
  campaignTargets CampaignTarget[]
  suggestions Suggestion[]
  deliveries  DeliveryAssignment[]

  @@index([tenantId])
  @@index([tenantId, phone])
  @@index([tenantId, routeId])
  @@index([tenantId, territoryId])
  @@index([tenantId, status])
}

// ---------- Calls ----------

model Call {
  id                  String        @id @default(cuid())
  tenantId            String
  externalCallId      String?       @unique // provider-side id
  direction           CallDirection
  status              CallStatus    @default(QUEUED)
  outcome             CallOutcome?
  languageQueue       LanguagePreference?
  productMenu         String?
  customerId          String?
  agentId             String?
  campaignId          String?
  campaignTargetId    String?
  fromNumber          String?
  toNumber            String?
  queuedAt            DateTime      @default(now())
  ringingAt           DateTime?
  connectedAt         DateTime?
  endedAt             DateTime?
  durationSec         Int?
  notes               String?
  recordingUrl        String?
  scheduledCallbackAt DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  agent    User?     @relation(fields: [agentId], references: [id])
  campaign Campaign? @relation(fields: [campaignId], references: [id])
  campaignTarget CampaignTarget? @relation(fields: [campaignTargetId], references: [id])
  orders   Order[]

  @@index([tenantId, agentId, createdAt])
  @@index([tenantId, customerId])
  @@index([tenantId, campaignId])
  @@index([tenantId, status])
}

// ---------- Campaigns ----------

model Campaign {
  id           String         @id @default(cuid())
  tenantId     String
  name         String
  type         CampaignType
  status       CampaignStatus @default(DRAFT)
  filters      Json           // filter spec
  pitch        String?        // agent script
  promoCode    String?
  createdById  String
  approvedById String?
  approvedAt   DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant    Tenant            @relation(fields: [tenantId], references: [id])
  createdBy User              @relation(fields: [createdById], references: [id])
  targets   CampaignTarget[]
  calls     Call[]
  orders    Order[]

  @@index([tenantId, status])
}

model CampaignTarget {
  id            String                @id @default(cuid())
  tenantId      String
  campaignId    String
  customerId    String
  status        CampaignTargetStatus  @default(PENDING)
  attempts      Int                   @default(0)
  lastAttemptAt DateTime?
  declineReason String?
  notes         String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])
  calls    Call[]

  @@unique([campaignId, customerId])
  @@index([tenantId, status])
}

// ---------- Orders ----------

model Order {
  id                String       @id @default(cuid())
  tenantId          String
  orderReference    String       @unique
  customerId        String
  agentId           String?
  callId            String?
  campaignId        String?
  promoId           String?
  status            OrderStatus  @default(DRAFT)
  subtotal          Decimal      @db.Decimal(12, 2) @default(0)
  discount          Decimal      @db.Decimal(12, 2) @default(0)
  total             Decimal      @db.Decimal(12, 2) @default(0)
  deliveryPreference String?
  routeId           String?
  notes             String?
  duplicateFlag     Boolean      @default(false)
  duplicateOfId     String?
  duplicateReviewStatus DuplicateReviewStatus?
  confirmedAt       DateTime?
  syncedAt          DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  customer    Customer     @relation(fields: [customerId], references: [id])
  agent       User?        @relation(fields: [agentId], references: [id])
  call        Call?        @relation(fields: [callId], references: [id])
  campaign    Campaign?    @relation(fields: [campaignId], references: [id])
  promo       Promotion?   @relation(fields: [promoId], references: [id])
  duplicateOf Order?       @relation("OrderDuplicate", fields: [duplicateOfId], references: [id])
  duplicates  Order[]      @relation("OrderDuplicate")
  lines       OrderLine[]
  syncJobs    DmsSyncJob[]
  delivery    DeliveryAssignment?

  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, agentId, createdAt])
  @@index([tenantId, duplicateFlag])
}

model OrderLine {
  id        String  @id @default(cuid())
  orderId   String
  skuId     String
  skuCode   String
  name      String
  qty       Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku   Sku   @relation(fields: [skuId], references: [id])

  @@index([orderId])
  @@index([skuId])
}

// ---------- DMS ----------

model DmsSyncJob {
  id           String          @id @default(cuid())
  tenantId     String
  orderId      String
  adapter      DmsAdapterKind
  status       DmsSyncStatus   @default(PENDING)
  attempts     Int             @default(0)
  lastError    String?
  payload      Json
  externalRef  String?
  nextRetryAt  DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, adapter, status])
}

model WebhookEvent {
  id          String        @id @default(cuid())
  tenantId    String
  source      String
  signature   String?
  payload     Json
  status      WebhookStatus @default(RECEIVED)
  error       String?
  processedAt DateTime?
  createdAt   DateTime      @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, source, status])
}

// ---------- Suggestions ----------

model Suggestion {
  id          String   @id @default(cuid())
  tenantId    String
  customerId  String
  skuId       String
  reason      String
  rule        String   // rule identifier e.g. "cadence", "overdue", "promo"
  score       Decimal  @db.Decimal(5, 2)
  suggestedQty Int
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sku      Sku      @relation(fields: [skuId], references: [id])

  @@index([tenantId, customerId])
}

// ---------- Delivery ----------

model DeliveryAssignment {
  id              String                 @id @default(cuid())
  tenantId        String
  orderId         String                 @unique
  customerId      String
  routeId         String
  driverId        String?
  status          DeliveryStatus         @default(PLANNED)
  scheduledFor    DateTime
  sequence        Int                    @default(0)
  attempts        Int                    @default(0)
  startedAt       DateTime?
  deliveredAt     DateTime?
  failureReason   DeliveryFailureReason?
  rescheduledFor  DateTime?
  driverName      String?
  amountCollected Decimal?               @db.Decimal(12, 2)
  paymentMethod   PaymentMethod?
  signatureUrl    String?
  proofPhotoUrl   String?
  notes           String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])
  route    Route    @relation(fields: [routeId], references: [id])
  driver   User?    @relation(fields: [driverId], references: [id])

  @@index([tenantId, routeId, scheduledFor])
  @@index([tenantId, driverId, scheduledFor])
  @@index([tenantId, status])
}

// ---------- Audit ----------

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  actorId   String?
  action    String   // e.g. "order.create", "campaign.approve"
  entity    String   // e.g. "Order"
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  actor  User?  @relation(fields: [actorId], references: [id])

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
}
