# ---- Database ----
DATABASE_URL="postgresql://teletrade:teletrade@localhost:5432/teletrade?schema=public"

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- API ----
API_PORT=4000
API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-please-rotate
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-please-rotate
JWT_ACCESS_TTL=900          # 15m
JWT_REFRESH_TTL=2592000     # 30d

# ---- Telephony ----
TELEPHONY_PROVIDER=mock     # mock | twilio | africastalking | sip

# ---- DMS ----
DMS_DEFAULT_ADAPTER=odoo    # odoo | sap_b1 | dynamics_365 | custom
DMS_ODOO_URL=
DMS_ODOO_DB=
DMS_ODOO_USERNAME=
DMS_ODOO_API_KEY=
DMS_CUSTOM_URL=
DMS_CUSTOM_TOKEN=

# ---- Integrations crypto ----
# AES-GCM key for encrypting tenant DMS credentials at rest + per-tenant webhook
# HMAC signing. Must be set to a 32+ char value in production (64 hex chars
# preferred). Rotating invalidates every tenant's stored API key AND every
# tenant's webhook signing secret.
INTEGRATIONS_SIGNING_KEY=change-me-integrations-key-min-32-chars-please-rotate

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
